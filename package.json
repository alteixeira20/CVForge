{
  "name": "cvforge",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.28",
      "sharp": "0.35.4",
      "nanoid@<3.3.18": "^3.3.18",
      "fflate@<0.8.3": "^0.8.3"
    }
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test:unit": "vitest run --config apps/web/vitest.config.ts",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:chromium": "pnpm --filter web test:e2e:chromium",
    "test:e2e:cross-browser": "pnpm --filter web test:e2e:cross-browser",
    "test:a11y": "pnpm --filter web test:a11y",
    "check:em-dash": "node tools/check-no-em-dash.mjs",
    "check:commits": "node tools/check-commit-messages.mjs",
    "audit": "pnpm audit",
    "audit-prod": "pnpm audit --prod"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
